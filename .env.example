# Nusxa oling: cp .env.example .env
# .env fayli git ga tushmasligi kerak.

# --- Panel admin hisobi -------------------------------------------------------
ADMIN_USER=admin

# Bu yerga yozilgan parol HAR DOIM ishlaydi — zaif bo'lsa ham. Zaifligi uchun
# faqat logga ogohlantirish chiqadi, panel cheklanmaydi.
#
# Qiymatni o'zgartirsangiz, konteynerni QAYTA YARATING (restart yetarli emas):
#   docker compose up -d --force-recreate web
#
# DIQQAT: parolda $ yoki # ishlatmang. docker compose $ ni o'zgaruvchi, # dan
# keyingi qismini izoh deb o'qiydi va parol buzilib yetib boradi. $ kerak bo'lsa
# ikki marta yozing: $$
#
# Bo'sh qoldirilsa — birinchi ishga tushishda tasodifiy parol yaratiladi va
# logga chiqadi (u holda birinchi kirishdan keyin almashtirish talab qilinadi):
#   docker compose logs web | grep "Vaqtinchalik parol"
ADMIN_PASS=

# Panel ichidan almashtirilgan parol ustunlik qiladi: undan keyin ADMIN_PASS ni
# o'zgartirmaguningizcha .env qiymati qayta yozmaydi.

# Bo'sh qoldiring — doimiy kalit avtomatik yaratilib data/state/secret_key da saqlanadi.
SECRET_KEY=

# --- VPN server ---------------------------------------------------------------
# Klientlar ulanadigan tashqi IP yoki domen. .ovpn fayllar ichiga yoziladi.
SERVER_IP=157.22.128.192

VPN_DNS1=1.1.1.1
VPN_DNS2=8.8.8.8

# Fragmentatsiyani oldini olish uchun MSS chegarasi. Uzilishlar bo'lsa 1300 ga tushiring.
VPN_MSSFIX=1360

# Tunnel MTU — tezlik uchun eng muhim sozlama.
# 1500 QO'YMANG: OpenVPN har paketga ~60 bayt qo'shadi, natijada har paket ikkiga
# bo'linadi — tezlik ~2 barobar tushadi va uzun yuklamalar uziladi.
# 1420 — odatiy internet uchun. PPPoE yoki mobil internetda 1400/1380 ga tushiring.
VPN_TUN_MTU=1420

# auto | 1 | 0 — DCO (yadro darajasidagi shifrlash, eng katta tezlik omili).
# auto: hostda ovpn moduli topilsa yoqiladi.
VPN_DCO=auto

# --- Xavfsizlik ---------------------------------------------------------------
# Reverse-proxy'da HTTPS yoqilgach 1 ga qo'ying.
SECURE_COOKIES=auto
# Oldida nechta ishonchli proxy turibdi (X-Forwarded-* sarlavhalari uchun).
TRUST_PROXY=1

# --- Avtomatik tozalash -------------------------------------------------------
INACTIVE_DISABLE_DAYS=30
INACTIVE_DELETE_DAYS=45

# --- Fayl egaligi -------------------------------------------------------------
# `id -u` va `id -g` natijalari. data/ katalogidagi fayllar shu egaga tegishli bo'ladi.
PUID=1000
PGID=1000

# Bitta hisob bilan bir nechta qurilmadan ulanish (telefon + noutbuk).
# 0 qilsangiz ikkinchi ulanish birinchisini uzadi va klient loglarida
# "bad packet ID (may be a replay)" xatolari to'planadi.
VPN_DUPLICATE_CN=1
