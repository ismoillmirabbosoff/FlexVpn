# Barqaror Alpine relizi: edge (rolling) har rebuild'da boshqa paket versiyalarini
# olib kelib, serverni kutilmaganda o'zgartirib qo'yardi. 3.24 — OpenVPN 2.7 + DCO.
ARG BASE=alpine:3.24
FROM ${BASE}

RUN apk add --no-cache \
        openvpn \
        easy-rsa \
        bash \
        iptables \
        openssl \
        python3 \
 && { openvpn --version | grep -q '\[DCO\]' \
      || { echo "XATO: paketda DCO yo'q:"; openvpn --version | head -1; exit 1; }; }

COPY scripts/ /opt/vpn-scripts/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /opt/vpn-scripts/*.py

EXPOSE 1194/udp

ENTRYPOINT ["/entrypoint.sh"]
